# Salin ke .env untuk development lokal (FE :3030, BE :3031, Postgres Docker :5433).
PORT=3031
DATABASE_URL=postgres://rt:rt@localhost:5433/rt_finance
CORS_ORIGINS=http://localhost:3030

# jumlah reverse proxy di depan app (nginx/Cloudflare); 0 di lokal tanpa proxy
TRUST_PROXY=0

# token login pengurus
JWT_SECRET=
# JWT_EXPIRES_IN=7d

# upload bukti transfer
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# 0 = matikan OCR bukti transfer otomatis (tiap 5 menit)
OCR_CRON_ENABLED=0

# Hanya kalau sengaja konek ke DB remote di luar production (mis. pg_dump produksi): ALLOW_REMOTE_DB=1
